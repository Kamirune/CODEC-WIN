<Window x:Class="CodecWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CODEC" Height="640" Width="720"
        MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/codec.ico"
        Background="#08070F" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ── 네온 색상 ── -->
        <Color x:Key="CyanColor">#22E9E9</Color>
        <Color x:Key="MagentaColor">#F03CB4</Color>
        <Color x:Key="IndigoColor">#7A5CFF</Color>
        <SolidColorBrush x:Key="Cyan" Color="#22E9E9"/>
        <SolidColorBrush x:Key="Magenta" Color="#F03CB4"/>
        <SolidColorBrush x:Key="Indigo" Color="#7A5CFF"/>
        <SolidColorBrush x:Key="TextDim" Color="#8A86B8"/>
        <SolidColorBrush x:Key="TextMain" Color="#E9E7FA"/>

        <!-- ── 패널 입체 배경: 위 밝고 아래 어둡게 (오목한 느낌) ── -->
        <LinearGradientBrush x:Key="PanelFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#161328" Offset="0"/>
            <GradientStop Color="#0F0C1E" Offset="1"/>
        </LinearGradientBrush>

        <!-- 패널 테두리: 위쪽 하이라이트 → 아래 어둡게 -->
        <LinearGradientBrush x:Key="PanelStroke" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A3560" Offset="0"/>
            <GradientStop Color="#211D3A" Offset="1"/>
        </LinearGradientBrush>

        <!-- 토글 선택 시 볼록한 입체 배경 -->
        <LinearGradientBrush x:Key="ToggleOnFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1C3A4A" Offset="0"/>
            <GradientStop Color="#112630" Offset="1"/>
        </LinearGradientBrush>

        <!-- 버튼 볼록 입체 -->
        <LinearGradientBrush x:Key="BtnFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2547" Offset="0"/>
            <GradientStop Color="#1A1630" Offset="1"/>
        </LinearGradientBrush>

        <!-- 공용 은은한 글로우 -->
        <DropShadowEffect x:Key="CyanGlow" Color="#22E9E9" BlurRadius="14"
                          ShadowDepth="0" Opacity="0.55"/>

        <!-- ── 모드 토글 (ENCODE/DECODE) ── -->
        <Style x:Key="ModeToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8A86B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- 글로우 레이어 (선택 시만 보임) -->
                            <Border x:Name="glow" CornerRadius="8" Background="#22E9E9"
                                    Opacity="0">
                                <Border.Effect>
                                    <BlurEffect Radius="16"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bd" CornerRadius="8" Padding="22,10"
                                    Background="Transparent"
                                    BorderBrush="#2A2540" BorderThickness="1">
                                <!-- 위쪽 안쪽 하이라이트 라인 -->
                                <Grid>
                                    <Border x:Name="hl" CornerRadius="8,8,0,0"
                                            Height="1" VerticalAlignment="Top"
                                            Background="#33FFFFFF" Opacity="0"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource ToggleOnFill}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#22E9E9"/>
                                <Setter TargetName="hl" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#5EF6F6"/>
                                <!-- 글로우 부드럽게 켜기/끄기 -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0.28" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A4470"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 어두운 ComboBox (드롭다운 글자 안 보이던 문제 해결) ── -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="bd" CornerRadius="7" Background="{StaticResource BtnFill}"
                    BorderBrush="{StaticResource PanelStroke}" BorderThickness="1">
                <Grid>
                    <Border CornerRadius="7,7,0,0" Height="1" VerticalAlignment="Top"
                            Background="#22FFFFFF"/>
                    <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,12,0" Fill="#22E9E9"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#22E9E9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E9E7FA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="14,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#141127" CornerRadius="7"
                                        BorderBrush="#3A3560" BorderThickness="1"
                                        Margin="0,4,0,0" MinWidth="{Binding ActualWidth,
                                        RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16"
                                                          ShadowDepth="3" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" Margin="4"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox 항목 스타일 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#C9C6E8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#1E2A44"/>
                                <Setter Property="Foreground" Value="#22E9E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 배경 이미지 위에 UI -->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/bg.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 헤더 ── -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource Cyan}"
                               VerticalAlignment="Center" Effect="{StaticResource CyanGlow}"/>
                    <TextBlock Text="CODEC" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="realtime encoder / decoder" FontSize="12"
                               Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                               Margin="14,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,4"/>
                </StackPanel>

                <!-- ── 컨트롤 바 ── -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="EncodeMode" Content="ENCODE"
                                     Style="{StaticResource ModeToggle}" IsChecked="True"
                                     Checked="Mode_Changed" Margin="0,0,10,0"/>
                        <RadioButton x:Name="DecodeMode" Content="DECODE"
                                     Style="{StaticResource ModeToggle}" Checked="Mode_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="방식" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MethodBox" Width="150"
                                  SelectionChanged="Method_Changed"/>
                        <StackPanel x:Name="ShiftPanel" Orientation="Horizontal"
                                    Visibility="Collapsed" Margin="12,0,0,0">
                            <TextBlock Text="shift" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border CornerRadius="7" Background="{StaticResource BtnFill}"
                                    BorderBrush="{StaticResource PanelStroke}" BorderThickness="1">
                                <TextBox x:Name="ShiftBox" Width="42" Height="34" Text="3"
                                         Background="Transparent" Foreground="{StaticResource Cyan}"
                                         CaretBrush="{StaticResource Cyan}" BorderThickness="0"
                                         FontFamily="Consolas"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         TextChanged="Input_Changed"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ── 입력 패널 ── -->
                <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource PanelFill}"
                        BorderBrush="{StaticResource PanelStroke}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12"
                                          ShadowDepth="2" Opacity="0.45"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 위쪽 안쪽 하이라이트 (오목한 입체) -->
                        <Border CornerRadius="12,12,0,0" Height="1" VerticalAlignment="Top"
                                Margin="1,0" Background="#22FFFFFF"/>
                        <TextBox x:Name="InputBox" Background="Transparent"
                                 Foreground="{StaticResource TextMain}"
                                 CaretBrush="{StaticResource Cyan}" BorderThickness="0"
                                 FontSize="15" Padding="14" FontFamily="Consolas"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Input_Changed"/>
                        <TextBlock x:Name="InputHint" Text="여기에 텍스트를 입력하세요..."
                                   Foreground="#4A4670" FontSize="15" FontFamily="Consolas"
                                   Margin="16,14,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- ── 중앙: 클릭 가능한 방향 라벨(=스왑) + 복사 ── -->
                <Grid Grid.Row="3" Margin="0,14">
                    <!-- 가운데 방향 라벨: 클릭하면 스왑 (버튼은 클릭영역, 텍스트는 그 위에 겹침) -->
                    <Button x:Name="SwapBtn" HorizontalAlignment="Center" Cursor="Hand"
                            Click="Swap_Click" BorderThickness="0" Background="Transparent"
                            ToolTip="클릭하면 출력↔입력을 전환합니다">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="swb" CornerRadius="8" Padding="16,6"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="swb" Property="Background" Value="#141127"/>
                                        <Setter TargetName="swb" Property="BorderBrush" Value="#3A3560"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="swb" Property="Background" Value="#0E0B1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock x:Name="ArrowText" Text="▼  BASE64  ▼"
                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource Cyan}"
                                       Effect="{StaticResource CyanGlow}"/>
                            <TextBlock x:Name="SwapHint" Text="click to swap"
                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                       FontSize="9" Foreground="#5A5680" Margin="0,3,0,0"
                                       Opacity="0.55"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CopyBtn" Content="COPY" Width="74" Height="32"
                            HorizontalAlignment="Right" Cursor="Hand"
                            Click="Copy_Click" Foreground="{StaticResource TextMain}"
                            FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Background="{StaticResource BtnFill}"
                                        CornerRadius="8" BorderBrush="{StaticResource PanelStroke}"
                                        BorderThickness="1">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="cbScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Border CornerRadius="8,8,0,0" Height="1"
                                                VerticalAlignment="Top" Background="#26FFFFFF"/>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- 호버 시 부드럽게 마젠타 테두리로 전환 -->
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetName="cb"
                                                    Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                                    To="#F03CB4" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetName="cb"
                                                    Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                                    To="#2A2540" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <!-- 누를 때 살짝 눌리는 느낌 -->
                                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="cbScale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    To="0.94" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="cbScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="0.94" Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="cbScale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="cbScale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── 출력 패널 ── -->
                <Border x:Name="OutputPanel" Grid.Row="4" CornerRadius="12"
                        Background="{StaticResource PanelFill}"
                        BorderThickness="1">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="OutBorderBrush" Color="#2A2540"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect x:Name="OutGlow" Color="#22E9E9" BlurRadius="12"
                                          ShadowDepth="0" Opacity="0"/>
                    </Border.Effect>
                    <Grid>
                        <Border CornerRadius="12,12,0,0" Height="1" VerticalAlignment="Top"
                                Margin="1,0" Background="#22FFFFFF"/>
                        <TextBox x:Name="OutputBox" IsReadOnly="True" Background="Transparent"
                                 Foreground="{StaticResource Cyan}" BorderThickness="0"
                                 FontSize="15" Padding="14" FontFamily="Consolas"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <!-- ── 상태바 ── -->
                <TextBlock x:Name="StatusText" Grid.Row="5" Margin="4,12,0,0"
                           FontSize="12" FontFamily="Consolas"
                           Foreground="{StaticResource TextDim}" Text="ready"/>
            </Grid>
        </Border>
    </Grid>
</Window>
