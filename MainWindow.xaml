<Window x:Class="CodecWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CODEC" Height="640" Width="720"
        MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/codec.ico"
        Background="#08070F" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 색상·버튼·콤보박스 스타일은 App.xaml에 있음 (도구 창과 공유) -->

    <!-- 배경 이미지 위에 UI -->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/bg.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Border Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 헤더 ── -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource Cyan}"
                               VerticalAlignment="Center" Effect="{StaticResource CyanGlow}"/>
                    <TextBlock Text="CODEC" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="realtime encoder / decoder" FontSize="12"
                               Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                               Margin="14,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,4"/>
                </StackPanel>

                <!-- 헤더 오른쪽: 도구 창 열기 -->
                <Button x:Name="ToolsBtn" Grid.Row="0" Content="TOOLS ⚙" Width="92"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                        Style="{StaticResource NeonBtn}" Click="Tools_Click"
                        ToolTip="진법 변환 · IP · 타임스탬프 · 파일↔Base64"/>

                <!-- ── 컨트롤 바 ── -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="EncodeMode" Content="ENCODE"
                                     Style="{StaticResource ModeToggle}" IsChecked="True"
                                     Checked="Mode_Changed" Margin="0,0,10,0"/>
                        <RadioButton x:Name="DecodeMode" Content="DECODE"
                                     Style="{StaticResource ModeToggle}" Checked="Mode_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="방식" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="MethodBox" Width="150"
                                  SelectionChanged="Method_Changed"/>
                        <StackPanel x:Name="ShiftPanel" Orientation="Horizontal"
                                    Visibility="Collapsed" Margin="12,0,0,0">
                            <TextBlock Text="shift" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border CornerRadius="7" Background="{StaticResource BtnFill}"
                                    BorderBrush="{StaticResource PanelStroke}" BorderThickness="1">
                                <TextBox x:Name="ShiftBox" Width="42" Height="34" Text="3"
                                         Background="Transparent" Foreground="{StaticResource Cyan}"
                                         CaretBrush="{StaticResource Cyan}" BorderThickness="0"
                                         FontFamily="Consolas"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         TextChanged="Input_Changed"/>
                            </Border>
                        </StackPanel>
                        <!-- hex 인코딩 출력 형식 (hex + ENCODE일 때만 표시) -->
                        <StackPanel x:Name="HexPanel" Orientation="Horizontal"
                                    Visibility="Collapsed" Margin="12,0,0,0">
                            <TextBlock Text="형식" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="HexFormatBox" Width="120"
                                      SelectionChanged="HexFormat_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ── 입력 패널 ── -->
                <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource PanelFill}"
                        BorderBrush="{StaticResource PanelStroke}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12"
                                          ShadowDepth="2" Opacity="0.45"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 위쪽 안쪽 하이라이트 (오목한 입체) -->
                        <Border CornerRadius="12,12,0,0" Height="1" VerticalAlignment="Top"
                                Margin="1,0" Background="#22FFFFFF"/>
                        <TextBox x:Name="InputBox" Background="Transparent"
                                 Foreground="{StaticResource TextMain}"
                                 CaretBrush="{StaticResource Cyan}" BorderThickness="0"
                                 FontSize="15" Padding="14,14,14,28" FontFamily="Consolas"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Input_Changed"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="#7A5CFF"
                                 SelectionChanged="Input_SelectionChanged"
                                 GotKeyboardFocus="Box_GotFocus"
                                 AllowDrop="True"
                                 PreviewDragEnter="Input_PreviewDragOver"
                                 PreviewDragOver="Input_PreviewDragOver"
                                 PreviewDrop="Input_PreviewDrop"/>
                        <TextBlock x:Name="InputHint" Text="여기에 텍스트를 입력하세요... (파일을 끌어다 놓으면 해시 계산)"
                                   Foreground="#4A4670" FontSize="15" FontFamily="Consolas"
                                   Margin="16,14,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Top"/>
                        <!-- 오른쪽 아래: 커서 위치 · 줄 · 글자 · 바이트 -->
                        <TextBlock x:Name="InputStats" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,16,8" FontSize="10" FontFamily="Consolas"
                                   Foreground="#5A5680" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- ── 찾기 / 바꾸기 막대 (Ctrl+F / Ctrl+H, 입력 패널 오른쪽 위에 겹쳐 표시) ── -->
                <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                        Background="#141127" BorderBrush="#3A3560" BorderThickness="1"
                        CornerRadius="8" Padding="8,6">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.6"/>
                    </Border.Effect>
                    <Border.Resources>
                        <Style x:Key="FindText" TargetType="TextBox">
                            <Setter Property="Width" Value="170"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="Background" Value="#0E0B1C"/>
                            <Setter Property="Foreground" Value="#E9E7FA"/>
                            <Setter Property="CaretBrush" Value="#22E9E9"/>
                            <Setter Property="BorderBrush" Value="#2A2540"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="FindBtn" TargetType="Button" BasedOn="{StaticResource NeonBtn}">
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="MinWidth" Value="28"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Margin" Value="4,0,0,0"/>
                            <Setter Property="Padding" Value="6,0"/>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="FindBox" Style="{StaticResource FindText}"
                                     TextChanged="FindBox_Changed" PreviewKeyDown="FindBox_KeyDown"
                                     ToolTip="찾을 내용 (Enter 다음, Shift+Enter 이전, Esc 닫기)"/>
                            <TextBlock x:Name="MatchText" Text="0/0" Width="54" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       FontFamily="Consolas" FontSize="11" Foreground="#8A86B8"/>
                            <Button x:Name="CaseBtn" Content="Aa" Style="{StaticResource FindBtn}"
                                    Click="Case_Click" Opacity="0.45" ToolTip="대소문자 구분"/>
                            <Button Content="▲" Style="{StaticResource FindBtn}" Click="FindPrev_Click"
                                    ToolTip="이전 (Shift+Enter)"/>
                            <Button Content="▼" Style="{StaticResource FindBtn}" Click="FindNext_Click"
                                    ToolTip="다음 (Enter)"/>
                            <Button Content="✕" Style="{StaticResource FindBtn}" Click="FindClose_Click"
                                    ToolTip="닫기 (Esc)"/>
                        </StackPanel>
                        <StackPanel x:Name="ReplaceRow" Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox x:Name="ReplaceBox" Style="{StaticResource FindText}"
                                     PreviewKeyDown="ReplaceBox_KeyDown"
                                     ToolTip="바꿀 내용 (Enter 하나 바꾸기)"/>
                            <Button x:Name="ReplaceBtn" Content="바꾸기" Width="54" Style="{StaticResource FindBtn}"
                                    Margin="10,0,0,0" Click="Replace_Click"/>
                            <Button x:Name="ReplaceAllBtn" Content="모두" Width="44" Style="{StaticResource FindBtn}"
                                    Click="ReplaceAll_Click" ToolTip="모두 바꾸기"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 중앙: 클릭 가능한 방향 라벨(=스왑) + 복사 ── -->
                <Grid Grid.Row="3" Margin="0,14">
                    <!-- 가운데 방향 라벨: 클릭하면 스왑 (버튼은 클릭영역, 텍스트는 그 위에 겹침) -->
                    <Button x:Name="SwapBtn" HorizontalAlignment="Center" Cursor="Hand"
                            Click="Swap_Click" BorderThickness="0" Background="Transparent"
                            ToolTip="클릭하면 출력↔입력을 전환합니다">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="swb" CornerRadius="8" Padding="16,6"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="swb" Property="Background" Value="#141127"/>
                                        <Setter TargetName="swb" Property="BorderBrush" Value="#3A3560"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="swb" Property="Background" Value="#0E0B1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock x:Name="ArrowText" Text="▼  BASE64  ▼"
                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource Cyan}"
                                       Effect="{StaticResource CyanGlow}"/>
                            <TextBlock x:Name="SwapHint" Text="click to swap"
                                       HorizontalAlignment="Center" FontFamily="Consolas"
                                       FontSize="9" Foreground="#5A5680" Margin="0,3,0,0"
                                       Opacity="0.55"/>
                        </StackPanel>
                    </Button>

                    <!-- 결과를 입력으로 보내고 같은 모드로 한 번 더 변환 (연속 디코딩) -->
                    <Button x:Name="AgainBtn" Content="AGAIN ↻" Width="86"
                            HorizontalAlignment="Left" Style="{StaticResource NeonBtn}"
                            Click="Again_Click"
                            ToolTip="결과를 입력으로 보내 같은 모드로 한 번 더 변환합니다 (Ctrl+Enter)"/>

                    <Button x:Name="CopyBtn" Content="COPY" Width="74"
                            HorizontalAlignment="Right" Style="{StaticResource NeonBtn}"
                            Click="Copy_Click"/>
                </Grid>

                <!-- ── 출력 패널 ── -->
                <Border x:Name="OutputPanel" Grid.Row="4" CornerRadius="12"
                        Background="{StaticResource PanelFill}"
                        BorderThickness="1">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="OutBorderBrush" Color="#2A2540"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect x:Name="OutGlow" Color="#22E9E9" BlurRadius="12"
                                          ShadowDepth="0" Opacity="0"/>
                    </Border.Effect>
                    <Grid>
                        <Border CornerRadius="12,12,0,0" Height="1" VerticalAlignment="Top"
                                Margin="1,0" Background="#22FFFFFF"/>
                        <TextBox x:Name="OutputBox" IsReadOnly="True" Background="Transparent"
                                 Foreground="{StaticResource Cyan}" BorderThickness="0"
                                 FontSize="15" Padding="14,14,14,28" FontFamily="Consolas"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="#7A5CFF"
                                 TextChanged="Output_Changed"
                                 GotKeyboardFocus="Box_GotFocus"/>
                        <TextBlock x:Name="OutputStats" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,16,8" FontSize="10" FontFamily="Consolas"
                                   Foreground="#5A5680" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- ── 상태바 + 문자셋 토글 ── -->
                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Margin="4,0,12,0"
                               FontSize="12" FontFamily="Consolas"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextDim}" Text="ready"/>
                    <!-- 클릭할 때마다 UTF-8 ↔ EUC-KR (바이트 기반 방식에만 적용) -->
                    <Button x:Name="CharsetBtn" Grid.Column="1" Content="UTF-8"
                            Width="84" Height="26" FontSize="11" FontFamily="Consolas"
                            Style="{StaticResource NeonBtn}" Click="Charset_Click"
                            ToolTip="문자셋: 클릭해서 UTF-8 ↔ EUC-KR 전환&#x0a;(base64·hex·url·binary·ascii·해시·auto에 적용)"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
