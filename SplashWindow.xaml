<Window x:Class="CodecWpf.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Width="460" Height="300" Topmost="True"
        Icon="pack://application:,,,/codec.ico">

    <!-- 둥근 카드 -->
    <Border CornerRadius="18" BorderThickness="1">
        <Border.Background>
            <ImageBrush ImageSource="pack://application:,,,/bg.png" Stretch="UniformToFill"/>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22E9E9" Offset="0"/>
                <GradientStop Color="#7A5CFF" Offset="0.5"/>
                <GradientStop Color="#F03CB4" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#7A5CFF" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 로고 (페이드+확대 인) -->
            <StackPanel x:Name="LogoPanel" Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.8" ScaleY="0.8"/>
                </StackPanel.RenderTransform>
                <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="52"
                           FontWeight="Bold" Foreground="#22E9E9" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#22E9E9" BlurRadius="26"
                                          ShadowDepth="0" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="CODEC" FontSize="52" FontWeight="Bold"
                           Foreground="#E9E7FA" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 태그라인 -->
            <TextBlock x:Name="Tagline" Grid.Row="1" Text="realtime encoder / decoder"
                       HorizontalAlignment="Center" FontFamily="Consolas" FontSize="13"
                       Foreground="#8A86B8" Opacity="0" Margin="0,0,0,22"/>

            <!-- 진행 바 -->
            <Border Grid.Row="2" Width="300" Height="3" CornerRadius="2"
                    Background="#211D3A" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border x:Name="ProgressBar" HorizontalAlignment="Left" Width="0"
                        CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#22E9E9" Offset="0"/>
                            <GradientStop Color="#F03CB4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#22E9E9" BlurRadius="10"
                                          ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
            </Border>

            <!-- 상태 텍스트 -->
            <TextBlock x:Name="BootText" Grid.Row="3" Text="INITIALIZING..."
                       HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11"
                       Foreground="#22E9E9" Opacity="0" Margin="0,0,0,24"/>
        </Grid>
    </Border>
</Window>
